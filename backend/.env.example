APP_NAME=ai-soc
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_soc
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me
LLM_PROVIDER=disabled
LLM_API_KEY=
LOG_LEVEL=INFO
BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_WINDOW_SECONDS=60
PASSWORD_SPRAY_UNIQUE_USERS=5
PASSWORD_SPRAY_WINDOW_SECONDS=300
PRIVILEGE_CHANGE_LOOKBACK_SECONDS=900
LARGE_DOWNLOAD_THRESHOLD_BYTES=1000000
LOGIN_AFTER_FAILURES_THRESHOLD=3
LOGIN_AFTER_FAILURES_WINDOW_SECONDS=900
