APP_NAME=ai-soc
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_soc
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2000
LLM_PROMPT_VERSION=v1
LLM_CONTEXT_MAX_CHARS=30000
INVESTIGATION_QUEUE_KEY=ai_soc:investigations
INVESTIGATION_WORKER_BLOCK_SECONDS=5
LOG_LEVEL=INFO
BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_WINDOW_SECONDS=60
PASSWORD_SPRAY_UNIQUE_USERS=5
PASSWORD_SPRAY_WINDOW_SECONDS=300
PRIVILEGE_CHANGE_LOOKBACK_SECONDS=900
LARGE_DOWNLOAD_THRESHOLD_BYTES=1000000
LOGIN_AFTER_FAILURES_THRESHOLD=3
LOGIN_AFTER_FAILURES_WINDOW_SECONDS=900
CREDENTIAL_COMPROMISE_LOOKBACK_SECONDS=1800
INCIDENT_MERGE_WINDOW_SECONDS=3600
RISK_SCORE_HIGH_SEVERITY_WEIGHT=20
RISK_SCORE_MEDIUM_SEVERITY_WEIGHT=10
RISK_SCORE_LOW_SEVERITY_WEIGHT=5
RISK_SCORE_CONFIDENCE_MULTIPLIER=20
RISK_SCORE_COMBO_BONUS=15
RISK_SCORE_SUPPORTING_BONUS=10
ML_ENABLED=true
ML_MODEL_NAME=isolation_forest_v1
ML_ARTIFACT_DIR=/app/artifacts/models
ML_AGGREGATION_WINDOW_SECONDS=300
ML_TRAINING_LOOKBACK_DAYS=30
ML_MIN_TRAINING_ROWS=200
ML_ISOLATION_FOREST_CONTAMINATION=0.05
ML_ISOLATION_FOREST_RANDOM_STATE=42
ML_ANOMALY_ALERT_THRESHOLD=-0.15
ML_FEATURE_VERSION=v1
